# Local values for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# In production these live in the Cloudflare dashboard, never in the repo.
# Server-side only — never prefix these with NEXT_PUBLIC_.
ARSEL_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=
# Optional locally: overrides CONTACT_TO_EMAIL from wrangler.jsonc.
CONTACT_TO_EMAIL=
