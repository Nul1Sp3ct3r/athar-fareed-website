{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "athar-fareed-website",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  // The Next.js static export. Every request is answered from these files
  // directly; only /api/* runs the Worker script first.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Contact form email (Arsel). Non-secret settings live here so every
  // `wrangler deploy` keeps them in sync. ARSEL_API_KEY is a dashboard
  // *secret* only (Settings → Variables and Secrets) — never put it in this
  // file. Locally, use .dev.vars.
  "vars": {
    "CONTACT_FROM_EMAIL": "noreply@uniqueimpact.sa",
    "CONTACT_FROM_NAME": "UNIQUE IMPACT",
    "CONTACT_TO_EMAIL": "info@uniqueimpact.sa"
  },

  "observability": { "enabled": true }
}
