{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "athar-fareed-website",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  // The Next.js static export. Every request is answered from these files
  // directly; only /api/* runs the Worker script first.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Contact form email (Arsel). ARSEL_API_KEY, CONTACT_FROM_EMAIL and
  // CONTACT_FROM_NAME are dashboard *secrets* (Settings → Variables and
  // Secrets) — plain-text dashboard variables are overwritten by every
  // `wrangler deploy`, secrets are not. Locally, use .dev.vars.
  "vars": {
    "CONTACT_TO_EMAIL": "info@uniqueimpact.sa"
  },

  "observability": { "enabled": true }
}
